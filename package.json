{
  "name": "lgndry",
  "version": "0.0.1",
  "main": "dist/elec/main.js",
  "scripts": {
    "ng": "ng",
    "start:ng": "ng serve",
    "start:elec": "electron dist/electron/main.js",
    "build:ng": "ng build --base-href ./",
    "build:elec": "tsc --project tsconfig.elec.json",
    "build": "npm run build:ng && npm run build:elec",
    "watch:ng": "ng build --watch --configuration development",
    "watch:elec": "tsc -w --project tsconfig.elec.json",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/language-server": "^22.0.8",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/jasmine": "~4.3.0",
    "electron": "^27.0.3",
    "jasmine-core": "~4.6.0",
    "jsdom": "^28.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
