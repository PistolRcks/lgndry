{
    "name": "lgndry",
    "version": "0.0.1",
    "main": "dist/elec/main.js",
    "scripts": {
        "ng": "ng",
        "start:ng": "ng serve",
        "start:elec": "electron dist/electron/main.js",
        "build:ng": "ng build --base-href ./",
        "build:elec": "tsc --project tsconfig.elec.json",
        "build": "npm run build:ng && npm run build:elec",
        "watch:ng": "ng build --watch --configuration development",
        "watch:elec": "tsc -w --project tsconfig.elec.json",
        "test": "ng test"
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^22.1.7",
        "@angular/compiler": "^22.1.7",
        "@angular/core": "^22.1.7",
        "@angular/forms": "^22.1.7",
        "@angular/language-server": "^22.1.7",
        "@angular/platform-browser": "^22.1.7",
        "@angular/router": "^22.1.7",
        "flowbite": "^4.0.2",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^22.1.7",
        "@angular/cli": "^22.1.7",
        "@angular/compiler-cli": "^22.1.7",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/jasmine": "~4.3.0",
        "electron": "^27.0.3",
        "flowbite-typography": "^1.0.5",
        "jasmine-core": "~4.6.0",
        "jsdom": "^28.0.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
        "vitest": "^4.0.8"
    }
}
